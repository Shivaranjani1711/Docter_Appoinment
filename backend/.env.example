# Server
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/doctor_appointment_dev

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-value
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-a-different-long-random-value
JWT_REFRESH_EXPIRES_IN=30d
COOKIE_DOMAIN=localhost

# Email (transactional only - verification, reminders)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Doctor Appointment Platform <no-reply@example.com>"

# File storage (S3-compatible, private bucket)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SIGNED_URL_TTL_SECONDS=300

# Video provider (Daily.co)
DAILY_API_KEY=
DAILY_API_BASE_URL=https://api.daily.co/v1

# Payments (Razorpay test mode)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Redis (rate limiting, background jobs)
REDIS_URL=redis://127.0.0.1:6379
